# Salin dari Supabase → Project Settings → API (atau tombol "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-dengan-anon-public-key-atau-publishable-key

# RAHASIA — hanya di server (tanpa NEXT_PUBLIC_). Dipakai untuk membuat akun guru/staf dan akun portal siswa/orang tua.
SUPABASE_SERVICE_ROLE_KEY=isi-dengan-service-role-atau-secret-key

# (Opsional) domain email internal untuk akun portal siswa/orang tua (login tetap pakai NISN).
# Jangan diubah setelah akun portal dibuat.
# PORTAL_EMAIL_DOMAIN=portal.sman22bdg.sch.id

# ---- Notifikasi WhatsApp & email (opsional; tanpa ini notifikasi tetap tampil di aplikasi) ----
# WhatsApp lewat Fonnte (https://fonnte.com) — token perangkat. RAHASIA.
# FONNTE_TOKEN=
# Email lewat Resend (https://resend.com) — RAHASIA. Pengirim harus domain yang sudah diverifikasi di Resend.
# RESEND_API_KEY=
# EMAIL_PENGIRIM=SMAN 22 Bandung <notifikasi@domain-sekolah.sch.id>
# Alamat website (untuk tautan di pesan), mis. https://sman22-web.vercel.app
# SITUS_URL=
# Rahasia untuk penjadwal pengiriman (Vercel Cron / cron-job.org). Isi teks acak panjang. RAHASIA.
# CRON_SECRET=

# ---- Asisten AI guru (opsional) — Claude API dari https://console.anthropic.com. RAHASIA. ----
# Dipakai untuk menyusun draf TP/ATP, kerangka modul ajar, dan slide materi. Tidak ada data siswa yang dikirim.
# ANTHROPIC_API_KEY=
# (Opsional) nama model; biarkan kosong untuk bawaan.
# AI_MODEL=

# --- Bimbingan & Konseling (Fase 12) ---
# Kunci enkripsi catatan konseling (min. 32 karakter acak). WAJIB disimpan salinannya di tempat aman:
# bila hilang, catatan BK lama tidak dapat dibuka. Jangan pernah diawali NEXT_PUBLIC_.
# Buat dengan: openssl rand -base64 36
# BK_KUNCI=
